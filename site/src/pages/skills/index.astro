---
import Base from "../../layouts/Base.astro";
import Glyph from "../../components/Glyph.astro";
import { groupedSkills, skillCount } from "../../data/catalog";
import { glyphs } from "../../data/plain";

const searchText = (entry: (typeof groupedSkills)[number]["entries"][number]) =>
  [entry.copy.name, entry.copy.does, ...entry.copy.asks, entry.slug].join(" ").toLowerCase();
---

<Base
  title="Skills | Roblox Suite"
  description={`Browse all ${skillCount} Roblox Suite skills by domain.`}
>
  <div class="page">
    <div class="wrap">
      <div class="page-head">
        <h1>{skillCount} skills</h1>
        <p class="page-lead">Install the full suite for automatic routing, or pick individual skills.</p>
      </div>

      <div class="search">
        <label for="skill-search">Filter</label>
        <input id="skill-search" type="search" placeholder="DataStore, Rojo, UI, NPC..." autocomplete="off" />
      </div>

      {
        groupedSkills.map((group) => (
          <section class="list-group" data-group>
            <div class="group-head">
              <h2>{group.title}</h2>
              <p class="group-note">{group.description}</p>
            </div>
            <ul class="cards">
              {group.entries.map((entry) => (
                <li data-search={searchText(entry)}>
                  <a class="card" href={`/skills/${entry.slug}/`} data-glow>
                    <span class="glyph-tile"><Glyph rows={glyphs[entry.slug]} /></span>
                    <span class="card-body">
                      <span class="skill-name">{entry.copy.name}</span>
                      <span class="skill-does">{entry.copy.does}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <p class="no-match" role="status" hidden>No matching skills.</p>
    </div>
  </div>

  <script>
    const input = document.querySelector<HTMLInputElement>("#skill-search")!;
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const empty = document.querySelector<HTMLElement>(".no-match")!;

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let total = 0;
      for (const group of groups) {
        let shown = 0;
        for (const row of group.querySelectorAll<HTMLElement>("li[data-search]")) {
          const match = !query || row.dataset.search!.includes(query);
          row.hidden = !match;
          if (match) shown++;
        }
        group.hidden = shown === 0;
        total += shown;
      }
      empty.hidden = total > 0;
    };

    input.addEventListener("input", filter);
    filter();
  </script>
</Base>
