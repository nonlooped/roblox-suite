---
import Base from "../../layouts/Base.astro";
import { SkillFinder, type Section } from "../../components/SkillFinder";
import { CopyCommand } from "../../components/CopyCommand";
import HowItWorks from "../../components/HowItWorks.astro";
import { groupedSkills, installCommand, plainLabel, repoUrl, skillCount } from "../../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/* Flattened here so the island receives only what it searches and renders. */
const sections: Section[] = groupedSkills.map((group) => ({
  id: group.id,
  title: group.title,
  description: group.description,
  tiles: group.entries.map((skill) => {
    const label = plainLabel(skill.slug);
    return {
      slug: skill.slug,
      name: label.name,
      blurb: label.blurb,
      haystack: [label.name, label.does, label.blurb, skill.slug, skill.oneLiner]
        .join(" ")
        .toLowerCase(),
    };
  }),
}));
---

<Base
  title="All skills | Roblox Suite"
  description={`Search ${skillCount} Roblox Suite skills for player data, gameplay, presentation, testing, and Studio workflows.`}
>
  <!-- The h1 carries the "N skills" string the deploy smoke test greps for. -->
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <h1 class="text-title max-w-2xl">{skillCount} skills, one install</h1>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-start">
        <CopyCommand client:load command={installCommand} className="sm:max-w-md" />
        <a
          href={repoUrl}
          rel="noopener"
          class="panel pressable inline-flex shrink-0 items-center justify-center whitespace-nowrap bg-toy-yellow px-5 py-3 font-display text-small font-bold text-ink"
        >
          Star on GitHub
        </a>
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <SkillFinder client:load base={base} sections={sections} />
    </div>
  </section>

  <!-- Kept off the landing page: this explains rather than persuades, and it
       is more use to someone already browsing the catalog. -->
  <HowItWorks />
</Base>
