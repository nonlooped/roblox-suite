---
import Base from "../../layouts/Base.astro";
import SkillsIndex from "../../components/SkillsIndex.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CodeChip from "../../components/CodeChip.astro";
import Inline from "../../components/Inline.astro";
import { skillsBySlug } from "../../data/skills-meta";

const base = import.meta.env.BASE_URL;

// The persuasive core: a curated set of "what your agent stops doing" pairs,
// surfaced here on the index instead of being buried on detail pages.
// Six pairs, one per domain where the evidence is sharpest, each linking to
// the skill that owns it.
type Pair = { slug: string; old: string; new: string; note?: string };
const pairs: Pair[] = [
  { slug: "roblox-core", old: "wait() / spawn() / delay()", new: "task.wait / task.spawn / task.defer", note: "the legacy globals are deprecated" },
  { slug: "roblox-networking", old: "Client-side economy and stat writes", new: "Server-authoritative validation on every purchase and save" },
  { slug: "roblox-datastores", old: "Race conditions from bare SetAsync", new: "Queue-based save patterns with retry and exponential backoff" },
  { slug: "roblox-animation", old: "Humanoid:LoadAnimation", new: "Animator:LoadAnimation", note: "with proper track lifecycle and marker-driven gameplay" },
  { slug: "roblox-teleport", old: "Deprecated Teleport / TeleportPartyAsync variants", new: "Unified TeleportAsync with TeleportOptions and TeleportAsyncResult" },
  { slug: "roblox-open-cloud", old: "Hardcoded Open Cloud keys in scripts", new: "Secrets Store + HttpService:GetSecret with least-privilege API keys", note: "60-day key auto-expiry; rotate on a schedule" },
];

const hub = skillsBySlug.get("roblox")!;
---

<Base
  title="Skills"
  description="All fifteen Roblox Suite skills, grouped by domain. Each links to a full page with the official Engine API Reference sources behind it."
>
  {/* ── Beat 1: Frame — what a skill is, where to start ─────────────── */}
  <section class="pt-[clamp(2.5rem,5vw,4.5rem)] pb-[clamp(2rem,4vw,3rem)]">
    <div class="wrap">
      <div class="grid grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-[clamp(2rem,5vw,4rem)] items-start max-[920px]:grid-cols-1 max-[920px]:gap-6">
        <div class="flex flex-col gap-6 items-start min-w-0" data-reveal>
          <p class="skills-hero-eyebrow font-mono text-xs font-semibold text-crimson tracking-[0.04em] uppercase">
            The skills
          </p>
          <h1 class="max-w-[22ch]">
            Fifteen skills. Each one a Markdown file your agent reads before writing Roblox code.
          </h1>
          <p class="lede max-w-[52ch] text-[clamp(1.125rem,0.5rem+0.9vw,1.375rem)] leading-[1.5] text-ink-soft font-normal">
            A skill is a small instruction file that tells your agent which Roblox APIs are current,
            which are deprecated, and where the official docs say so. Install them once, ask your
            agent anything, and it builds against the right call instead of guessing from memory.
          </p>
          <div class="flex flex-wrap gap-3 items-center">
            <a class="btn-primary" href={`${base}skills/roblox`}>Start with the hub</a>
            <a class="btn-ghost" href="#catalog">Browse the catalog</a>
          </div>
        </div>

        <aside
          class="skills-hero-hub flex flex-col gap-3 p-6 bg-surface border border-border rounded-xl"
          data-reveal
        >
          <p class="skills-hero-hub-label text-xs font-bold text-on-crimson bg-crimson self-start px-[0.6em] py-[0.2em] rounded-full">
            Start here
          </p>
          <a
            class="group skills-hero-hub-link flex flex-col gap-2 p-4 border border-border rounded-sm transition-[border-color,background,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-crimson-line hover:bg-surface-2 motion-safe:hover:translate-x-[3px]"
            href={`${base}skills/roblox`}
          >
            <span class="skills-hero-hub-title font-mono text-[1.0625rem] font-semibold text-ink">
              {hub.title}
            </span>
            <span class="skills-hero-hub-desc text-sm text-ink-soft leading-[1.45]">
              <Inline text={hub.oneLiner} />
            </span>
            <span class="skills-hero-hub-slug font-mono text-xs text-muted">
              {hub.slug}
            </span>
          </a>
          <p class="text-muted text-xs leading-[1.45]">
            The entry point skill. It routes your agent to the right specialist.
          </p>
          <div class="mt-2">
            <CodeChip />
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ── Beat 2: Proof — what your agent stops doing ─────────────────── */}
  <section
    class="section bg-[color-mix(in_oklch,var(--color-bg)_92%,var(--color-surface))] border-y border-border"
  >
    <div class="wrap">
      <div data-reveal>
        <SectionHeading
          title="What your agent stops doing."
          lead="The clearest signal a skill sends: it tells your agent to stop reaching for deprecated or broken patterns and use the current call instead. Six examples, one per domain. Every detail page has its own set."
        />
      </div>

      <ol
        class="skills-proof-list flex flex-col mt-12 border-t border-border"
        data-reveal-stagger
      >
        {
          pairs.map((p) => (
            <li class="border-b border-border">
              <a
                class="group grid grid-cols-[minmax(0,1fr)_auto] gap-4 items-center py-6 px-3 transition-[background,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-surface motion-safe:hover:translate-x-[3px] max-[720px]:grid-cols-1 max-[720px]:gap-3"
                href={`${base}skills/${p.slug}`}
              >
                <div class="skills-proof-pair grid grid-cols-[1fr_auto_1fr] items-center gap-4 min-w-0 max-[720px]:grid-cols-1 max-[720px]:gap-2">
                  <div class="grid grid-cols-[1.3em_1fr] gap-3 items-start min-w-0">
                    <span class="text-muted text-[0.95rem] leading-[1.4]" aria-hidden="true">✕</span>
                    <span class="text-muted leading-[1.4] break-words">{p.old}</span>
                  </div>
                  <div class="text-crimson font-semibold text-center max-[720px]:text-left max-[720px]:pl-[1.3em]">
                    →
                  </div>
                  <div class="grid grid-cols-[1.3em_1fr] gap-3 items-start min-w-0">
                    <span class="text-crimson font-bold text-[0.95rem] leading-[1.4]" aria-hidden="true">✓</span>
                    <div class="flex flex-col gap-1 min-w-0">
                      <span class="text-ink leading-[1.4] break-words">{p.new}</span>
                      {p.note && (
                        <span class="text-muted text-xs leading-[1.4]">{p.note}</span>
                      )}
                    </div>
                  </div>
                </div>
                <span
                  class="skills-proof-slug self-center font-mono text-xs text-muted whitespace-nowrap transition-colors duration-200 group-hover:text-crimson max-[720px]:justify-self-start"
                >
                  {p.slug}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ── Beat 3: Catalog — the domain index ─────────────────────────── */}
  <section class="pt-[clamp(3.5rem,7vw,5.5rem)] pb-[clamp(3.5rem,7vw,5.5rem)]" id="catalog">
    <div class="wrap">
      <div data-reveal>
        <SectionHeading
          title="The catalog."
          lead="All fifteen skills grouped by domain, the same way the suite publishes them to the skills.sh registry. Each links to a full page with the official sources behind it."
        />
      </div>
      <div class="mt-12" data-reveal>
        <SkillsIndex />
      </div>
    </div>
  </section>
</Base>