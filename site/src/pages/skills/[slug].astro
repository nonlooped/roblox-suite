---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { CopyCommand } from "../../components/CopyCommand";
import {
  breakableUrl,
  groupedSkills,
  plainLabel,
  skills,
  skillInstallCommand,
  skillSourceUrl,
  withCode,
  type Skill,
} from "../../data/catalog";

export const getStaticPaths = (() =>
  skills.map((skill) => ({
    params: { slug: skill.slug },
    props: { skill },
  }))) satisfies GetStaticPaths;

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const label = plainLabel(skill.slug);

const group = groupedSkills.find((candidate) => candidate.skills.includes(skill.slug));
const siblings = (group?.entries ?? []).filter((entry) => entry.slug !== skill.slug);
const sourcesForCover = (coverIndex: number) =>
  skill.cover_sources[coverIndex].map((sourceIndex) => ({
    sourceIndex,
    source: skill.sources[sourceIndex - 1]!,
  }));

/*
 * "Critical risk" told a reader nothing actionable. The same three levels,
 * named for how much care the topic wants rather than for a severity scale.
 */
const riskCopy: Record<Skill["risk"], string> = {
  lower: "Straightforward",
  medium: "A few gotchas",
  critical: "Easy to get wrong",
};

/*
 * Care level is carried by the label text as well as the fill, never by colour
 * alone. All three use ink: paper on toy-red measures 3.54:1, under AA for
 * this text size, while ink on toy-red clears it at 4.88:1.
 */
const riskClass: Record<Skill["risk"], string> = {
  lower: "bg-toy-green text-ink",
  critical: "bg-toy-red text-ink",
  medium: "bg-toy-yellow text-ink",
};
---

{/* The catalog writes overviews for agents, so they carry markdown code spans.
    Left raw they reached the meta description as literal backticks. */}
<Base
  title={`${skill.displayTitle} | Roblox Suite`}
  description={skill.overview.replace(/`/g, "")}
>
  <article>
    <section class="py-12 sm:py-14">
      <div class="mx-auto max-w-4xl px-6">
        <nav class="flex items-center gap-2 text-small text-on-brand-muted" aria-label="Breadcrumb">
          <a href={`${base}/skills/`} class="transition-colors hover:text-on-brand">Skills</a>
          {group && <span aria-hidden="true">/</span>}
          {
            group && (
              <a href={`${base}/skills/#${group.id}`} class="transition-colors hover:text-on-brand">
                {group.title}
              </a>
            )
          }
        </nav>

        <!-- The plain name leads. The catalog's own title is written for
             agents and reads as a spec line, so it labels the skill file in
             the sidebar instead of heading the page. -->
        <h1 class="text-title mt-5">{label.name}</h1>
        <p class="measure mt-4 text-lead text-on-brand-muted">{label.blurb}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          <span
            class={`rounded-full border-2 border-ink px-3 py-1 text-[0.8125rem] font-medium ${riskClass[skill.risk]}`}
          >
            {riskCopy[skill.risk]}
          </span>
          <span
            class="rounded-full border-2 border-on-brand/30 px-3 py-1 font-mono text-[0.8125rem] text-on-brand-muted"
          >
            {skill.slug}
          </span>
        </div>

        <div class="mt-7 max-w-xl">
          <p class="mb-2.5 text-small text-on-brand-muted">Install just this one:</p>
          <CopyCommand client:load command={skillInstallCommand(skill.slug)} />
        </div>
      </div>
    </section>

    <section class="border-t border-on-brand/20 py-12 sm:py-14">
      <div class="mx-auto grid max-w-4xl gap-10 px-6 lg:grid-cols-[1fr_15rem]">
        <!-- Allow the grid column to shrink so long source URLs wrap within the viewport. -->
        <div class="min-w-0">
          <h2 class="text-heading">What it handles</h2>
          <ul class="mt-5 flex flex-col gap-3">
            {
              skill.covers.map((item, index) => (
                <li class="flex gap-3 text-on-brand-muted">
                  {/* A stud, not a dot: the list marker is the same brick
                      vocabulary as the panels around it. */}
                  <span
                    class="mt-2 size-2.5 shrink-0 rounded-[3px] border-2 border-ink bg-toy-yellow"
                    aria-hidden="true"
                  />
                  <span class="measure">
                    <span set:html={withCode(item)} />
                    <span class="ml-1 inline-flex gap-1 whitespace-nowrap font-mono text-[0.8125rem]">
                      {
                        sourcesForCover(index).map(({ source, sourceIndex }) => (
                          <a
                            href={source.url}
                            data-claim-citation={`${index + 1}:${sourceIndex}`}
                            aria-label={`Source ${sourceIndex}: ${source.label}`}
                            class="text-toy-yellow underline underline-offset-2 hover:no-underline"
                          >
                            [{sourceIndex}]
                          </a>
                        ))
                      }
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>

          <!-- Folded away by default. The citations above are the proof a
               reader actually follows; the full list was a page of URLs
               between them and the rest of the catalog. -->
          <details class="panel mt-10 bg-paper px-5 py-4 text-on-paper">
            <summary
              class="cursor-pointer list-none font-display text-small font-bold marker:content-none"
            >
              <span class="text-brand underline underline-offset-4"
                >Where this comes from ({skill.sources.length}
                {skill.sources.length === 1 ? " link" : " links"})</span
              >
            </summary>

            <!-- Not "Roblox's docs": the Rojo skill cites Rojo's own pages,
                 because Roblox does not document a third-party tool. -->
            <p class="mt-3 text-small text-on-paper-muted">
              The pages this skill was checked against, and the date of the last check.
            </p>

            <ul class="mt-4 flex flex-col divide-y divide-on-paper/10 border-y border-on-paper/10">
              {
                skill.sources.map((source, index) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                    <a
                      href={source.url}
                      rel="noopener"
                      class="font-medium text-brand underline underline-offset-4 hover:no-underline"
                    >
                      [{index + 1}] {source.label}
                    </a>
                    <span class="font-mono text-[0.8125rem] text-on-paper-muted">
                      checked {source.verified_at}
                    </span>
                    {/* Wrapped at path separators rather than truncated: an
                        ellipsis hides exactly the part that identifies the
                        page. Full muted text keeps AA; /70 measured 3.59:1. */}
                    <span
                      class="w-full break-words font-mono text-[0.8125rem] text-on-paper-muted"
                      set:html={breakableUrl(source.url)}
                    />
                  </li>
                ))
              }
            </ul>
          </details>
        </div>

        <aside class="flex flex-col gap-5">
          <div class="panel bg-ink p-5 text-on-ink">
            <h2 class="font-display text-small font-bold text-toy-yellow">Full details</h2>
            <p class="mt-2.5 text-small text-on-ink-muted">{skill.displayTitle}</p>
            <a
              href={skillSourceUrl(skill.slug)}
              rel="noopener"
              class="mt-3 inline-block font-mono text-[0.8125rem] text-paper underline underline-offset-4 hover:no-underline"
            >
              {skill.slug}/SKILL.md
            </a>
          </div>

          {
            siblings.length > 0 && group && (
              <div class="panel bg-paper p-5 text-on-paper">
                <h2 class="font-display text-small font-bold text-brand">Related</h2>
                <ul class="mt-3 flex flex-col gap-2">
                  {siblings.map((entry) => (
                    <li>
                      <a
                        href={`${base}/skills/${entry.slug}/`}
                        class="text-small text-on-paper-muted transition-colors hover:text-on-paper"
                      >
                        {plainLabel(entry.slug).name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </section>
  </article>
</Base>
