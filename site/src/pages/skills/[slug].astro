---
import Base from "../../layouts/Base.astro";
import CopyCommand from "../../components/CopyCommand.astro";
import Glyph from "../../components/Glyph.astro";
import GlyphTile from "../../components/GlyphTile.astro";
import Icon from "../../components/Icon.astro";
import { exampleStatusCopy } from "../../data/copy";
import { glyphs, skillStory } from "../../data/plain";
import {
  fileSourceUrl,
  formatDate,
  getEntry,
  groupedSkills,
  reportUrl,
  skillCount,
  skillInstallCommand,
  skillReferences,
  skillSourceUrl,
  skills,
  withCode,
} from "../../data/catalog";

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug } }));
}

const { slug } = Astro.params;
const skill = getEntry(slug!);
const { copy } = skill;
const story = skillStory[skill.slug];
const group = groupedSkills.find((g) => g.entries.some((e) => e.slug === skill.slug))!;
const others = group.entries.filter((e) => e.slug !== skill.slug);
const references = skillReferences(skill.slug);
const exampleFiles = skill.examples.files;
---

<Base title={`${copy.name} (${skill.slug}) | Roblox Suite`} description={`${copy.does}. ${skill.overview}`}>
  <article class="page">
    <div class="wrap wrap--narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/skills/">Skills</a></li>
          <li aria-current="page">{copy.name}</li>
        </ol>
      </nav>

      <div class="skill-head">
        <GlyphTile slug={skill.slug} large />
        <div class="page-head">
          <h1>{copy.name}</h1>
          <p class="page-lead">{copy.does}.</p>
        </div>
      </div>

      {skill.hub && <p class="note">Entry-point skill. Routes multi-system tasks to specialist skills automatically.</p>}

      <div class="story">
        <section class="story-panel story-panel--without">
          <h2>Default agent</h2>
          <p>{story.without}</p>
        </section>
        <section class="story-panel story-panel--with">
          <h2><Icon name="check" />With skill</h2>
          <p>{story.with}</p>
        </section>
      </div>

      <h2>Example prompts</h2>
      <ul class="asks">
        {
          copy.asks.map((ask) => (
            <li>
              <button
                class="ask"
                type="button"
                data-copy={ask}
                data-copied-label="Copied"
                data-idle-label="Copy"
              >
                <span class="ask-text" data-copy-source>{`\u201C${ask}\u201D`}</span>
                <span class="ask-hint" data-copy-label aria-live="polite">Copy</span>
              </button>
            </li>
          ))
        }
      </ul>

      <h2>Install</h2>
      <CopyCommand command={skillInstallCommand(skill.slug)} label="Install command" />
      <p class="get-line">Or <a href="/install/">install all {skillCount} skills</a>.</p>

      {
        skill.risk === "critical" && (
          <p class="note note--risk">
            <strong>High-impact domain.</strong> Bugs here can lose player data, break purchases, or open exploits. Review and playtest generated code.
          </p>
        )
      }

      <details class="tech">
        <summary>
          <span class="sum-text">
            <span class="sum-main">Technical details</span>
            <span class="sum-sub">Coverage, examples, and verified sources.</span>
          </span>
        </summary>
        <div class="tech-body">
          <h3>Coverage</h3>
          <ul class="covers">
            {
              skill.covers.map((cover, index) => (
                <li>
                  <Fragment set:html={withCode(cover)} />
                  <sup class="cite">
                    {skill.cover_sources[index].map((source) => (
                      <a href={`#source-${source}`} data-claim-citation={`${index + 1}:${source}`} aria-label={`Source ${source}`}>
                        {source}
                      </a>
                    ))}
                  </sup>
                </li>
              ))
            }
          </ul>

          {
            references.length > 0 && (
              <>
                <h3>References</h3>
                <ul class="rows">
                  {references.map((ref) => (
                    <li>
                      <a class="row-link row-link--single" href={fileSourceUrl(skill.slug, `references/${ref.file}`)}>
                        {ref.readWhen || ref.file}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }

          {
            exampleFiles.length > 0 && (
              <>
                <h3>Example scripts</h3>
                <ul class="rows script-rows">
                  {exampleFiles.map((file) => {
                    const status = exampleStatusCopy[file.status];
                    return (
                      <li>
                        <div class="script-line">
                          <a href={fileSourceUrl(skill.slug, file.path)}>
                            <code>{file.path.split("/").pop()}</code>
                          </a>
                          {status && <span class="pill">{status.label}</span>}
                        </div>
                        {status && <p class="inside-note">{status.explain}</p>}
                      </li>
                    );
                  })}
                </ul>
              </>
            )
          }

          <h3>Sources</h3>
          <ol class="source-list">
            {
              skill.sources.map((source, index) => (
                <li id={`source-${index + 1}`}>
                  <a href={source.url}>{source.label}</a>
                  <span>Verified {formatDate(source.verified_at)}</span>
                </li>
              ))
            }
          </ol>

          <p class="tech-meta">
            <code>{skill.slug}</code>
            <span>Updated {formatDate(skill.last_changed_at)}</span>
          </p>
          <p class="tech-links">
            <a href={skillSourceUrl(skill.slug)}>View on GitHub</a>
            <a href={reportUrl}>Report an issue</a>
          </p>
        </div>
      </details>

      {
        others.length > 0 && (
          <>
            <h2>More in {group.title}</h2>
            <ul class="cards">
              {others.map((entry) => (
                <li>
                  <a class="card" href={`/skills/${entry.slug}/`} data-glow>
                    <span class="glyph-tile"><Glyph rows={glyphs[entry.slug]} /></span>
                    <span class="card-body">
                      <span class="skill-name">{entry.copy.name}</span>
                      <span class="skill-does">{entry.copy.does}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </article>

  <script>
    const details = document.querySelector<HTMLDetailsElement>(".tech");
    document.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-claim-citation]") && details) details.open = true;
    });
  </script>
</Base>
