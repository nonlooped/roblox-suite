---
import Base from "../../layouts/Base.astro";
import Inline from "../../components/Inline.astro";
import CodeChip from "../../components/CodeChip.astro";
import { skills, skillsBySlug } from "../../data/skills-meta";
import { oldVsNew } from "../../data/old-vs-new";
import {
  freshness,
  skillGithubUrl,
  skillRefsGithubUrl,
  installSingleSkill,
} from "../../data/trust";

export function getStaticPaths() {
  return skills.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const skill = skillsBySlug.get(slug)!;
const pairs = oldVsNew.filter((r) => r.slug === slug);
const base = import.meta.env.BASE_URL;
const plainLiner = skill.oneLiner.replace(/`/g, "");
---

<Base title={skill.title} description={plainLiner}>
  <article class="section">
    <div class="wrap">
      <a
        class="link inline-flex gap-1.5 text-[0.9375rem] text-ink-soft mb-10 group"
        href={`${base}skills`}
      >
        <span aria-hidden="true" class="transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:-translate-x-1">←</span>
        All skills
      </a>

      <div class="grid grid-cols-[minmax(0,1fr)_19rem] gap-[clamp(2rem,5vw,4.5rem)] items-start max-[860px]:grid-cols-1 max-[860px]:gap-6">
        <div class="min-w-0">
          <header class="flex flex-col gap-3 mb-8">
            <h1
              class="text-[clamp(2rem,1rem+3vw,2.75rem)] font-mono font-semibold tracking-[-0.02em]"
            >
              {skill.title}
            </h1>
            <div class="flex flex-wrap gap-2">
              <span class="font-mono text-[0.8125rem] text-muted">{skill.slug}</span>
              {skill.hub && (
                <span class="text-[0.6875rem] font-bold text-on-crimson bg-crimson px-[0.55em] py-[0.15em] rounded-full">
                  hub · entry point
                </span>
              )}
            </div>
          </header>

          <p
            class="lede mb-12 max-w-[52ch] text-[clamp(1.125rem,0.5rem+0.9vw,1.375rem)] leading-[1.5] text-ink-soft font-normal"
          >
            <Inline text={skill.oneLiner} />
          </p>

          <section class="mb-12 last:mb-0">
            <h2 class="text-[0.8125rem] font-semibold text-muted mb-4">
              What it covers
            </h2>
            <ul class="flex flex-col gap-3">
              {
                skill.covers.map((c) => (
                  <li class="grid grid-cols-[1.5em_1fr] gap-3 text-ink-soft leading-[1.5]">
                    <span class="text-muted text-center" aria-hidden="true">—</span>
                    <span><Inline text={c} /></span>
                  </li>
                ))
              }
            </ul>
          </section>

          {
            pairs.length > 0 && (
              <section class="mb-12">
                <h2 class="text-[0.8125rem] font-semibold text-muted mb-4">
                  What you stop doing
                </h2>
                <ul class="flex flex-col gap-5">
                  {pairs.map((p) => (
                    <li class="grid grid-rows-[auto_auto] gap-2 pb-5 border-b border-border last:border-b-0 last:pb-0">
                      <div class="grid grid-cols-[1.3em_1fr] gap-3 items-start">
                        <span class="text-muted text-[0.95rem] leading-[1.5]" aria-hidden="true">✕</span>
                        <p class="text-muted">{p.old}</p>
                      </div>
                      <div class="grid grid-cols-[1.3em_1fr] gap-3 items-start">
                        <span class="text-crimson font-bold text-[0.95rem] leading-[1.5]" aria-hidden="true">✓</span>
                        <div>
                          <p class="text-ink">{p.new}</p>
                          {p.note && (
                            <p class="text-muted text-[0.875rem] mt-[0.3em]">
                              {p.note}
                            </p>
                          )}
                          {p.current && (
                            <span class="inline-block mt-2 text-[0.6875rem] font-bold text-on-crimson bg-crimson px-[0.55em] py-[0.15em] rounded-full">
                              current
                            </span>
                          )}
                        </div>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section class="mb-12 last:mb-0">
            <h2 class="text-[0.8125rem] font-semibold text-muted mb-4">
              Key sources
            </h2>
            <ul class="flex flex-col gap-3 mb-4">
              {
                skill.sources.map((s) => (
                  <li>
                    <a class="link text-[0.9375rem]" href={s.url}>
                      {s.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="text-muted text-[0.875rem] max-w-[52ch]">
              Taken verbatim from this skill's "Official sources" block. The full
              reference set lives in{" "}
              <a class="link" href={skillRefsGithubUrl(skill.slug)}>
                references/ on GitHub
              </a>
              .
            </p>
          </section>
        </div>

        <aside class="flex flex-col gap-5 sticky top-[calc(66px+1.5rem)] min-w-0 max-[860px]:static max-[860px]:flex-col max-[860px]:gap-4 max-[860px]:pt-10 max-[860px]:border-t max-[860px]:border-border">
          <p
            class="inline-flex items-center gap-2 text-xs font-semibold text-ink-soft bg-surface border border-border px-[0.85em] py-[0.45em] rounded-full tracking-[-0.005em] self-start"
          >
            <span class="w-[7px] h-[7px] rounded-full bg-crimson flex-none" aria-hidden="true"></span>
            Last reviewed {freshness.lastReviewed}
          </p>
          <div class="flex flex-col gap-3">
            <a class="btn-primary" href={`${base}#install`}>Add the suite</a>
            <a class="btn-ghost" href={skillGithubUrl(skill.slug)}>
              SKILL.md on GitHub
            </a>
          </div>
          <div class="flex flex-col gap-3 pt-5 border-t border-border">
            <p class="text-[0.8125rem] font-semibold text-muted">
              Install just this skill
            </p>
            <CodeChip command={installSingleSkill(skill.slug)} />
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>