---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import {
  breakableUrl,
  groupedSkills,
  plainLabel,
  skills,
  skillSourceUrl,
  withCode,
  type Skill,
} from "../../data/catalog";

export const getStaticPaths = (() =>
  skills.map((skill) => ({
    params: { slug: skill.slug },
    props: { skill },
  }))) satisfies GetStaticPaths;

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const label = plainLabel(skill.slug);

const group = groupedSkills.find((candidate) => candidate.skills.includes(skill.slug));
const siblings = (group?.entries ?? []).filter((entry) => entry.slug !== skill.slug);
const sourcesForCover = (coverIndex: number) =>
  skill.cover_sources[coverIndex].map((sourceIndex) => ({
    sourceIndex,
    source: skill.sources[sourceIndex - 1]!,
  }));

const riskCopy: Record<Skill["risk"], string> = {
  lower: "Easy to spot if it goes wrong",
  medium: "Problems show up later, under load",
  critical: "Get this wrong and players lose data or money",
};

/*
 * Risk is carried by the label text as well as the fill, never by colour
 * alone. All three use ink: paper on toy-red measures 3.54:1, under AA for
 * this text size, while ink on toy-red clears it at 4.88:1.
 */
const riskClass: Record<Skill["risk"], string> = {
  lower: "bg-toy-green text-ink",
  critical: "bg-toy-red text-ink",
  medium: "bg-toy-yellow text-ink",
};
---

{/* The catalog writes overviews for agents, so they carry markdown code spans.
    Left raw they reached the meta description as literal backticks. */}
<Base
  title={`${skill.displayTitle} — Roblox Suite`}
  description={skill.overview.replace(/`/g, "")}
>
  <article>
    <section class="py-14 sm:py-16">
      <div class="mx-auto max-w-4xl px-6">
        <nav class="flex items-center gap-2 text-small text-on-brand-muted" aria-label="Breadcrumb">
          <a href={`${base}/skills/`} class="transition-colors hover:text-on-brand">Skills</a>
          {group && <span aria-hidden="true">/</span>}
          {
            group && (
              <a href={`${base}/skills/#${group.id}`} class="transition-colors hover:text-on-brand">
                {group.title}
              </a>
            )
          }
        </nav>

        <h1 class="text-title mt-6">{skill.displayTitle}</h1>
        <p class="measure mt-4 text-lead text-on-brand-muted">{label.blurb}</p>

        <div class="mt-7 flex flex-wrap items-center gap-2.5">
          <span
            class={`rounded-full border-2 border-ink px-3 py-1 text-[0.8125rem] font-medium ${riskClass[skill.risk]}`}
          >
            {riskCopy[skill.risk]}
          </span>
          <span
            class="rounded-full border-2 border-on-brand/30 px-3 py-1 font-mono text-[0.8125rem] text-on-brand-muted"
          >
            {skill.slug}
          </span>
          <span
            class="rounded-full border-2 border-on-brand/30 px-3 py-1 text-[0.8125rem] text-on-brand-muted"
          >
            {skill.sources.length} sources, catalog updated {skill.last_changed_at}
          </span>
        </div>

        <!-- Wraps rather than scrolling sideways: the `--skill` flag is the
             whole point of this command and it sat past the panel edge. -->
        <div
          class="panel-sm mt-8 flex items-start gap-3 bg-ink px-4 py-3 font-mono text-small text-on-ink"
        >
          <span class="shrink-0 text-toy-green" aria-hidden="true">$</span>
          <span class="min-w-0 flex-1 break-words"
            >npx skills add nonlooped/roblox-suite --skill {skill.slug}</span
          >
        </div>
      </div>
    </section>

    <section class="bg-paper py-16 text-on-paper sm:py-20">
      <div class="mx-auto grid max-w-4xl gap-12 px-6 lg:grid-cols-[1fr_15rem]">
        <!--
          min-w-0: the truncated source URLs below are nowrap, so without this
          the grid item's min-content width pushes past the viewport and the
          paper ground stops short of the text sitting on it.
        -->
        <div class="min-w-0">
          <h2 class="text-heading">What it handles</h2>
          <ul class="mt-5 flex flex-col gap-3">
            {
              skill.covers.map((item, index) => (
                <li class="flex gap-3 text-on-paper-muted">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                  <span class="measure">
                    <span set:html={withCode(item)} />
                    <span class="ml-1 inline-flex gap-1 whitespace-nowrap font-mono text-[0.8125rem]">
                      {
                        sourcesForCover(index).map(({ source, sourceIndex }) => (
                          <a
                            href={source.url}
                            data-claim-citation={`${index + 1}:${sourceIndex}`}
                            aria-label={`Source ${sourceIndex}: ${source.label}`}
                            class="text-brand underline underline-offset-2 hover:no-underline"
                          >
                            [{sourceIndex}]
                          </a>
                        ))
                      }
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>

          <h2 class="text-heading mt-14">Where this comes from</h2>
          <p class="measure mt-2.5 text-on-paper-muted">
            Sources for the cited items above. Each citation lists the date it was checked.
          </p>

          <ul class="mt-6 flex flex-col divide-y divide-on-paper/10 border-y border-on-paper/10">
            {
              skill.sources.map((source, index) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3.5">
                  <a
                    href={source.url}
                    rel="noopener"
                    class="font-medium text-brand underline underline-offset-4 hover:no-underline"
                  >
                    [{index + 1}] {source.label}
                  </a>
                  <span class="font-mono text-[0.8125rem] text-on-paper-muted">
                    checked {source.verified_at}
                  </span>
                  <!-- Full muted, not /70: the tinted 70% measured 3.59:1 on
                       paper, under AA. Hierarchy comes from size and family
                       against the brand-blue link above it, not from fading.
                       Wrapped at path separators rather than truncated, which
                       cut the citation short on any phone-width column. -->
                  <span
                    class="w-full break-words font-mono text-[0.8125rem] text-on-paper-muted"
                    set:html={breakableUrl(source.url)}
                  />
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="flex flex-col gap-5">
          <div class="panel bg-ink p-5 text-on-ink">
            <h2 class="font-display text-small font-bold text-toy-yellow">Full details</h2>
            <p class="mt-2.5 text-small text-on-ink-muted">
              The complete skill file lives in the repo.
            </p>
            <a
              href={skillSourceUrl(skill.slug)}
              rel="noopener"
              class="mt-3 inline-block font-mono text-[0.8125rem] text-paper underline underline-offset-4 hover:no-underline"
            >
              {skill.slug}/SKILL.md
            </a>
          </div>

          {
            siblings.length > 0 && group && (
              <div class="panel bg-brand p-5 text-on-brand">
                <h2 class="font-display text-small font-bold text-toy-yellow">Related</h2>
                <ul class="mt-3 flex flex-col gap-2">
                  {siblings.map((entry) => (
                    <li>
                      <a
                        href={`${base}/skills/${entry.slug}/`}
                        class="text-small text-on-brand-muted transition-colors hover:text-on-brand"
                      >
                        {plainLabel(entry.slug).name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </div>
    </section>
  </article>
</Base>
