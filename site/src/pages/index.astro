---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import DomainsTeaser from "../components/DomainsTeaser.astro";
import InstallCTA from "../components/InstallCTA.astro";
import { repoUrl, skillsShUrl } from "../data/trust";

const base = import.meta.env.BASE_URL;
const siteOrigin = (Astro.site ?? "https://nonlooped.github.io").toString().replace(/\/$/, "");

// Home-page JSON-LD: SoftwareApplication describing the suite itself.
// This is the highest-leverage schema for ranking on the suite's own name.
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Roblox Suite",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (cross-platform via skills.sh CLI)",
  description:
    "Fifteen battle-tested Roblox Luau skills for AI agents. Every API recommendation is cited to the official Engine API Reference, not pulled from stale memory.",
  url: `${siteOrigin}${base}`.replace(/\/+$/, "/"),
  downloadUrl: repoUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://opensource.org/licenses/MIT",
  author: { "@type": "Person", name: "nonlooped", url: repoUrl },
  publisher: {
    "@type": "Organization",
    name: "Roblox Suite",
    url: repoUrl,
    logo: { "@type": "ImageObject", url: `${siteOrigin}${base}favicon.svg` },
    sameAs: [repoUrl, skillsShUrl],
  },
  featureList: [
    "Fifteen curated Roblox Luau skills",
    "Every API recommendation cited to the official Engine API Reference",
    "Deprecated-vs-current guidance per skill",
    "Installs via the skills.sh CLI as plain Markdown",
    "CI link-checks, schema validation, and spell-checks keep docs accurate",
  ],
};
---

<Base
  tags={["Roblox Studio skills", "Roblox Luau agent", "Roblox Engine API", "AI coding assistant", "skills.sh", "Luau"]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
  <Hero />
  <HowItWorks />
  <DomainsTeaser />
  <InstallCTA />
</Base>