---
import Base from "../layouts/Base.astro";
import { Hero } from "../components/Hero";
import { InstallPicker } from "../components/InstallPicker";
import JobPicker from "../components/JobPicker.astro";
import { installCommand, repoUrl, skillCount } from "../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/* Structured metadata identifies the suite as a free developer tool. */
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Roblox Suite",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  description: `${skillCount} skills for AI agents writing Roblox code, with API guidance and links to official documentation.`,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  codeRepository: repoUrl,
  license: "https://opensource.org/licenses/MIT",
  offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
};
---

<!-- Two doors, in the order people arrive at them: the job you have, then the
     command you run. -->
<Base
  title="Roblox Suite | Roblox docs for coding agents"
  description={`${skillCount} skills that show your coding agent the right Roblox API, with the official docs attached.`}
  schema={schema}
>
  <Hero client:load installCommand={installCommand} repoUrl={repoUrl} skillCount={skillCount} />

  <JobPicker base={base} />

  <!-- Keep the install command prominent in the closing section. -->
  <section class="bg-toy-yellow py-16 text-ink sm:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-title">One command, then restart your agent</h2>

      <InstallPicker client:visible installCommand={installCommand} skillCount={skillCount} />

      <p class="mt-7 text-small text-ink/75">
        Free and open source. <a
          href={repoUrl}
          rel="noopener"
          class="font-medium underline underline-offset-4 hover:no-underline focus-visible:outline-ink"
          >Star it on GitHub</a
        >.
      </p>
    </div>
  </section>
</Base>
