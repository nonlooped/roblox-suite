---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import DomainsTeaser from "../components/DomainsTeaser.astro";
import InstallCTA from "../components/InstallCTA.astro";
import { repoUrl, skillsShUrl } from "../data/trust";
import { skillCount } from "../data/skills-meta";

const base = import.meta.env.BASE_URL;
const siteOrigin = (Astro.site ?? "https://nonlooped.github.io").toString().replace(/\/$/, "");

// Home-page JSON-LD: SoftwareApplication describing the suite itself.
// This is the highest-leverage schema for ranking on the suite's own name.
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Roblox Suite",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (cross-platform via skills.sh CLI)",
  description: `${skillCount} source-grounded Roblox Luau skills for AI agents, with official sources and measurable verification coverage.`,
  url: `${siteOrigin}${base}`.replace(/\/+$/, "/"),
  downloadUrl: repoUrl,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://opensource.org/licenses/MIT",
  author: { "@type": "Person", name: "nonlooped", url: repoUrl },
  publisher: {
    "@type": "Organization",
    name: "Roblox Suite",
    url: repoUrl,
    logo: { "@type": "ImageObject", url: `${siteOrigin}${base}favicon.svg` },
    sameAs: [repoUrl, skillsShUrl],
  },
  featureList: [
    `${skillCount} curated Roblox Luau skills`,
    "Official source lists and per-source verification dates",
    "Risky-or-legacy versus recommended guidance per skill",
    "Installs via the skills.sh CLI as plain Markdown",
    "CI validates content structure, Luau examples, site routes, links, and spelling",
  ],
};
---

<Base
  tags={["Roblox Studio skills", "Roblox Luau agent", "Roblox Engine API", "AI coding assistant", "skills.sh", "Luau"]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(appSchema)} />
  <Hero />
  <DomainsTeaser />
  <InstallCTA />
</Base>
