---
import Base from "../layouts/Base.astro";
import {
  breakableUrl,
  latestSourceCheckAt,
  officialSourceCount,
  oldestSourceCheckAt,
  plainLabel,
  repoUrl,
  skillCount,
  skills,
  sourceCount,
  supportingSourceCount,
  uniqueSourceUrls,
} from "../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const rows = skills
  .flatMap((skill) => skill.sources.map((source) => ({ skill: skill.slug, ...source })))
  .sort(
    (a, b) => b.verified_at.localeCompare(a.verified_at) || a.skill.localeCompare(b.skill),
  );
---

<Base
  title="Sources — Roblox Suite"
  description={`All ${sourceCount} documentation sources behind the suite, with the date each was checked.`}
>
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h1 class="text-title">Show your work</h1>
      <p class="measure mt-5 text-lead text-on-brand-muted">
        {sourceCount} documentation citations across {
          uniqueSourceUrls.size
        } source pages, backing {skillCount} skills. Open any of them and see for yourself.
      </p>
      <!-- Named rather than averaged into one "official" number: Rojo is a
           third-party tool, so its own docs are the authoritative page for it. -->
      <p class="measure mt-4 text-on-brand-muted">
        {officialSourceCount} come from Roblox's own Creator Hub. The other {supportingSourceCount}
        cite Rojo's documentation and releases, because Rojo is a third-party tool and Roblox does
        not document it.
      </p>
      <p class="measure mt-4 text-on-brand-muted">
        Citation checks range from {oldestSourceCheckAt} through {latestSourceCheckAt}. Spotted
        something stale?{" "}
        <a
          href={`${repoUrl}/issues/new?template=inaccuracy.yml`}
          rel="noopener"
          class="text-toy-yellow underline underline-offset-4 hover:no-underline">Tell us</a
        > and we will correct it.
      </p>
    </div>
  </section>

  <!--
    A real table: this page is a citation list, so it should look like one.

    Below 40rem it becomes a stack of records instead. Three columns in 327px
    meant the differentiating "Checked" date sat ~500px off the right edge,
    reachable only by horizontal panning — the one column a sceptic is here
    for. The explicit ARIA roles keep the table semantics that `display: block`
    otherwise strips, so assistive tech reads the same relationships at both
    sizes. Fixed layout above 40rem stops the nowrap URLs from setting the
    table's min-content width and pushing a scrollbar onto tablet widths.
  -->
  <section class="bg-paper py-14 text-on-paper sm:py-16">
    <div class="mx-auto max-w-5xl px-6">
      <div class="overflow-x-auto">
        <table role="table" class="w-full border-collapse text-left max-sm:block sm:table-fixed">
          <caption class="sr-only">
            Documentation sources behind each skill, with verification dates
          </caption>
          <thead role="rowgroup" class="max-sm:sr-only">
            <tr role="row" class="border-b border-on-paper/20">
              <th
                role="columnheader"
                scope="col"
                class="py-3 pr-4 font-display text-small font-bold sm:w-[24%]">Skill</th
              >
              <th role="columnheader" scope="col" class="py-3 pr-4 font-display text-small font-bold"
                >Source</th
              >
              <th
                role="columnheader"
                scope="col"
                class="py-3 font-display text-small font-bold sm:w-[6.75rem]">Checked</th
              >
            </tr>
          </thead>
          <tbody role="rowgroup" class="max-sm:block">
            {
              rows.map((row) => (
                <tr
                  role="row"
                  class="border-b border-on-paper/10 align-baseline max-sm:block max-sm:py-4"
                >
                  <td role="cell" class="py-3 pr-4 max-sm:block max-sm:py-0">
                    <a
                      href={`${base}/skills/${row.skill}/`}
                      class="text-small text-on-paper-muted underline underline-offset-4 hover:no-underline"
                    >
                      {plainLabel(row.skill).name}
                    </a>
                  </td>
                  <td role="cell" class="py-3 pr-4 max-sm:block max-sm:py-0 max-sm:pt-1">
                    <a
                      href={row.url}
                      rel="noopener"
                      class="text-small font-medium text-brand underline underline-offset-4 hover:no-underline"
                    >
                      {row.label}
                    </a>
                    {/* Wrapped at path separators rather than truncated: on a
                        citation page the URL is the proof, and an ellipsis hid
                        exactly the part that identifies the page. */}
                    <span
                      class="block break-words font-mono text-[0.8125rem] text-on-paper-muted"
                      set:html={breakableUrl(row.url)}
                    />
                  </td>
                  <td
                    role="cell"
                    class="whitespace-nowrap py-3 font-mono text-[0.8125rem] text-on-paper-muted max-sm:block max-sm:py-0 max-sm:pt-1.5"
                  >
                    {/* The column header is off-screen on the stack, so the
                        date has to name itself. Hidden from AT, which still
                        gets the header through the row/column association. */}
                    <span class="sm:hidden" aria-hidden="true">
                      Checked{" "}
                    </span>
                    {row.verified_at}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
