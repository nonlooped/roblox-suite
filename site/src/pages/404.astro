---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base title="Not found" noindex>
  <section class="section min-h-[62vh] flex items-center">
    <div class="wrap flex flex-col gap-6 items-start max-w-[40rem]">
      <p
        class="font-mono font-semibold text-ink-soft leading-none tracking-[-0.04em] text-[clamp(3rem,1rem+6vw,5rem)]"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="text-[clamp(1.75rem,1rem+2.5vw,2.5rem)]">
        This page isn't in the suite.
      </h1>
      <p class="lede text-[clamp(1.125rem,0.5rem+0.9vw,1.375rem)] leading-[1.5] text-ink-soft max-w-[58ch] font-normal">
        The link may be stale - a little like a deprecated API. Try one of
        these instead.
      </p>
      <div class="flex flex-wrap gap-3 mt-2">
        <a class="btn-primary" href={base}>Back to home</a>
        <a class="btn-ghost" href={`${base}skills`}>Browse skills</a>
      </div>
    </div>
  </section>
</Base>