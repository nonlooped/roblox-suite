---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
---

<Base title="Page not found | Roblox Suite" description="This page does not exist." noindex>
  <div class="page">
    <div class="wrap">
      <div class="lost">
        <div class="lost-glyph"><Mark width={132} /></div>
        <h1>Page not found</h1>
        <p class="page-lead">That route doesn't exist. Browse the skill catalog instead.</p>
        <a class="button" href="/skills/">Browse skills</a>
      </div>
    </div>
  </div>
</Base>
