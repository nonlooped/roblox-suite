---
import Base from "../layouts/Base.astro";
import { skillCount } from "../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="Not found — Roblox Suite"
  description="That page doesn't exist. Browse the full skill catalog instead."
  noindex
>
  <section class="flex min-h-[60vh] items-center py-24">
    <div class="mx-auto max-w-lg px-6">
      <p class="font-display text-display text-toy-yellow">404</p>
      <h1 class="text-heading mt-4">This brick came loose</h1>
      <p class="measure mt-4 text-on-brand-muted">
        That link is out of date. All {skillCount} skills are still where you left them.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={`${base}/skills/`}
          class="panel pressable inline-flex items-center justify-center bg-toy-yellow px-5 py-3 font-display text-small font-bold text-ink"
        >
          Browse skills
        </a>
        <a
          href={`${base}/`}
          class="panel pressable inline-flex items-center justify-center bg-ink px-5 py-3 font-display text-small font-bold text-paper"
        >
          Go home
        </a>
      </div>
    </div>
  </section>
</Base>
