---
import { freshness, officialSources, repoUrl } from "../data/trust";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section" id="why">
  <div class="wrap grid grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-[clamp(2rem,5vw,4.5rem)] items-start max-[820px]:grid-cols-1 max-[820px]:gap-8">
    <SectionHeading
      title="Why trust it."
      lead="Not adjectives — structure. Every recommendation in every skill links to the official Engine API Reference, and a CI pipeline fails the build when that drifts."
    />

    <div class="flex flex-col gap-12">
      <p class="text-[1.125rem] leading-[1.55] text-ink max-w-[52ch]">
        All <strong class="font-semibold text-ink">{freshness.referenceCount} reference files</strong> were
        re-verified against official Roblox documentation as of
        {freshness.lastReviewed}. The suite is accountable to the source — not
        to a blog post from 2019.
      </p>

      <div class="flex flex-col gap-4">
        <h3 class="text-[0.8125rem] font-semibold text-muted">
          Policy the suite already reflects
        </h3>
        <ul class="flex flex-col gap-4">
          {
            freshness.policyNotes.map((p) => (
              <li class="grid grid-cols-[8.5rem_1fr] gap-4 items-start max-[820px]:grid-cols-1 max-[820px]:gap-[0.2em]">
                <span class="font-mono text-[0.8125rem] text-ink-soft max-[820px]:pt-0 pt-[0.15em]">
                  {p.date}
                </span>
                <span class="text-ink-soft text-[0.9375rem] leading-[1.5]">
                  {p.text}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-[0.8125rem] font-semibold text-muted">
          Accuracy is enforced, not asserted
        </h3>
        <ul class="flex flex-col gap-3">
          {
            freshness.ciChecks.map((c) => (
              <li class="grid grid-cols-[1.3em_1fr] gap-3 items-start text-ink-soft text-[0.9375rem] leading-[1.5]">
                <span class="text-crimson font-bold" aria-hidden="true">
                  ✓
                </span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
        <a
          class="link link-arrow mt-2 inline-flex items-baseline gap-1.5 text-[0.9375rem] group"
          href={`${repoUrl}/blob/main/.github/workflows/validate.yml`}
        >
          See the workflow on GitHub
          <span
            class="transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-[0.8125rem] font-semibold text-muted">
          The three official sources
        </h3>
        <ul class="flex flex-col gap-4">
          {
            officialSources.map((s) => (
              <li class="flex flex-col gap-[0.2em]">
                <a class="link text-[0.9375rem]" href={s.url}>
                  {s.label}
                </a>
                <span class="text-muted text-[0.8125rem]">{s.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>