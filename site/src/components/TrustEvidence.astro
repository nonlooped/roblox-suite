---
import { freshness, officialSources, repoUrl } from "../data/trust";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section trust" id="why">
  <div class="wrap trust__grid">
    <SectionHeading
      title="Why trust it."
      lead="Not adjectives — structure. Every recommendation in every skill links to the official Engine API Reference, and a CI pipeline fails the build when that drifts."
    />

    <div class="trust__body">
      <p class="trust__lede">
        All <strong>{freshness.referenceCount} reference files</strong> were
        re-verified against official Roblox documentation as of
        {freshness.lastReviewed}. The suite is accountable to the source — not
        to a blog post from 2019.
      </p>

      <div class="trust__block">
        <h3 class="trust__label">Policy the suite already reflects</h3>
        <ul class="trust__policy">
          {
            freshness.policyNotes.map((p) => (
              <li>
                <span class="trust__date mono">{p.date}</span>
                <span class="trust__policy-text">{p.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="trust__block">
        <h3 class="trust__label">Accuracy is enforced, not asserted</h3>
        <ul class="trust__ci">
          {
            freshness.ciChecks.map((c) => (
              <li>
                <span class="trust__tick" aria-hidden="true">
                  ✓
                </span>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>
        <a
          class="trust__ci-link link link--arrow"
          href={`${repoUrl}/blob/main/.github/workflows/validate.yml`}
        >
          See the workflow on GitHub
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="trust__block">
        <h3 class="trust__label">The three official sources</h3>
        <ul class="trust__sources">
          {
            officialSources.map((s) => (
              <li>
                <a class="link" href={s.url}>
                  {s.label}
                </a>
                <span class="muted trust__src-note">{s.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .trust__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .trust__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
  .trust__lede {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 52ch;
  }
  .trust__lede strong {
    color: var(--ink);
    font-weight: 600;
  }
  .trust__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .trust__label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted);
  }
  .trust__policy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .trust__policy li {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .trust__date {
    color: var(--ink-soft);
    font-size: 0.8125rem;
    padding-top: 0.15em;
  }
  .trust__policy-text {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .trust__ci {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .trust__ci li {
    display: grid;
    grid-template-columns: 1.3em 1fr;
    gap: var(--space-3);
    align-items: start;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .trust__tick {
    color: var(--crimson);
    font-weight: 700;
  }
  .trust__ci-link {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
  .trust__sources {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .trust__sources li {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }
  .trust__sources .link { font-size: 0.9375rem; }
  .trust__src-note { font-size: 0.8125rem; }

  @media (max-width: 820px) {
    .trust__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .trust__policy li {
      grid-template-columns: 1fr;
      gap: 0.2em;
    }
    .trust__date { padding-top: 0; }
  }
</style>