---
import HeroLedger from "./HeroLedger.astro";
import CodeChip from "./CodeChip.astro";
import { skillCount } from "../data/skills-meta";

const base = import.meta.env.BASE_URL;
---

<section class="py-[clamp(2.5rem,5vw,4.5rem)] pb-[clamp(3.5rem,8vw,6rem)]">
  <div class="wrap grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] gap-[clamp(2rem,5vw,4.5rem)] items-center max-[920px]:grid-cols-1 max-[920px]:gap-[clamp(2.5rem,6vw,4rem)]">
    <div class="flex flex-col gap-6 items-start min-w-0">
      <h1 class="max-w-[15ch]">Your AI agent, writing current Roblox code.</h1>
      <p class="lede max-w-[42ch] text-[clamp(1.125rem,0.5rem+0.9vw,1.375rem)] leading-[1.5] text-ink-soft font-normal">
        {skillCount} skills that keep your agent on current Roblox APIs - not stale training data.
      </p>
      <div class="flex flex-col gap-2.5 self-stretch max-w-[32rem]">
        <CodeChip />
      </div>
      <div class="flex flex-wrap gap-3 items-center">
        <a class="btn-primary" href={`${base}#install`}>Install</a>
        <a class="btn-ghost" href={`${base}skills`}>Browse skills</a>
      </div>
    </div>
    <div class="hero-visual min-w-0 max-[920px]:max-w-[34rem] w-full">
      <HeroLedger />
    </div>
  </div>
</section>
