---
// The hero's proof object: a compact deprecation ledger of real, dated
// old→new pairs. This replaces the abstract signal metaphor per Design
// Principle #1 ("show the API, don't sell the metaphor") and DESIGN.md's
// intended home structure ("Hero (ledger + install)"). Pairs are pulled
// from the single oldVsNew source of truth so they never drift from the
// skill pages. Each row links to the skill that owns the deprecation.
import { oldVsNew } from "../data/old-vs-new";

const base = import.meta.env.BASE_URL;

// Three of the sharpest, most-recognized deprecations, selected by the
// exact `old` string so the hero curates without duplicating copy.
const wanted = [
  "wait() / spawn() / delay()",
  "Humanoid:LoadAnimation",
  "Premium Payouts integration",
];
const rows = wanted
  .map((oldStr) => oldVsNew.find((r) => r.old === oldStr))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));
---

<figure
  class="hero-ledger m-0 rounded-xl border border-border bg-[color-mix(in_oklch,var(--color-bg)_82%,var(--color-surface))] overflow-hidden shadow-[0_1px_0_0_var(--color-border)]"
>
  <figcaption
    class="flex items-center justify-between gap-3 px-5 py-3 border-b border-border"
  >
    <span class="font-mono text-xs font-semibold text-ink-soft tracking-[0.01em]">
      Deprecated <span class="text-crimson" aria-hidden="true">→</span> current
    </span>
    <span class="font-mono text-[0.6875rem] text-muted">the ledger</span>
  </figcaption>

  <ul class="flex flex-col">
    {
      rows.map((r) => (
        <li class="border-b border-border last:border-b-0">
          <a
            class="group flex flex-col gap-1.5 px-5 py-3.5 transition-colors duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-surface"
            href={`${base}skills/${r.slug}`}
          >
            <span class="flex items-baseline gap-2 min-w-0">
              <span class="text-muted text-xs flex-none" aria-hidden="true">✕</span>
              <code class="font-mono text-[0.8125rem] text-muted line-through decoration-muted/40 break-words">
                <span class="sr-only">Deprecated: </span>{r.old}
              </code>
            </span>
            <span class="flex items-baseline gap-2 min-w-0">
              <span class="text-crimson text-xs font-bold flex-none" aria-hidden="true">✓</span>
              <code class="font-mono text-[0.8125rem] text-ink break-words">
                <span class="sr-only">Use instead: </span>{r.new}
              </code>
            </span>
            {r.note && (
              <span class="text-[0.6875rem] text-muted leading-[1.4] pl-[1.4em]">
                {r.note}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>

</figure>
