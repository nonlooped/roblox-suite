---
// Compact domain → skill list. Skill names are the value; no marketing lead.
import { groups } from "../data/groups";
import { skillsForGroup } from "../data/skills-meta";

const base = import.meta.env.BASE_URL;
---

<section class="section" id="skills">
  <div class="wrap">
    <div class="flex flex-wrap items-baseline justify-between gap-3 mb-8" data-reveal>
      <h2 class="text-[clamp(1.5rem,1rem+1.5vw,2rem)]">The skills</h2>
      <a class="link inline-flex items-baseline gap-1.5 group text-sm" href={`${base}skills`}>
        Full catalog
        <span class="transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>

    <ul
      class="domains-list grid grid-cols-2 gap-0 border-t border-border max-[720px]:grid-cols-1"
      data-reveal-stagger
    >
      {
        groups.map((g, i) => {
          const list = skillsForGroup(g.skills);
          return (
            <li
              class:list={[
                "domains-row border-b border-border py-5 px-4",
                i % 2 === 0 && "min-[721px]:border-r min-[721px]:border-border",
              ]}
            >
              <a
                class="group block"
                href={`${base}skills#g-${g.id}`}
              >
                <span class="font-semibold text-ink text-[1.0625rem] transition-colors duration-200 group-hover:text-crimson">
                  {g.title}
                </span>
                <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
                  {list.map((s) => (
                    <li>
                      <span class="font-mono text-xs text-ink-soft">{s.slug}</span>
                    </li>
                  ))}
                </ul>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
