---
// A copyable command chip. Markup only — the copy behaviour is a single
// delegated handler in Base.astro, keyed off [data-copy].
import { installCommand } from "../data/trust";

const { command = installCommand } = Astro.props as { command?: string };
---

<div
  class="codechip inline-flex items-center gap-3 px-[1.05em] py-[0.7em] bg-surface border border-border-strong rounded-lg font-mono text-[0.9375rem] w-[min(100%,30rem)] min-w-0"
>
  <span class="text-muted select-none" aria-hidden="true">$</span>
  <code
    class="flex-1 min-w-0 overflow-x-auto whitespace-nowrap text-ink bg-transparent border-0 p-0 text-inherit font-medium [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-copy-text
  >
    {command}
  </code>
  <button
    class="codechip-btn flex-none inline-flex items-center gap-1.5 px-3 py-2 rounded-sm border border-border bg-surface-2 text-ink-soft font-sans text-[0.8125rem] font-semibold cursor-pointer transition-[color,border-color,background] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-ink hover:border-border-strong is-copied:text-on-crimson is-copied:bg-crimson is-copied:border-crimson"
    type="button"
    data-copy="[data-copy-text]"
    aria-label="Copy command to clipboard"
  >
    <svg class="flex-none" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.5 2.5H4.5A1.5 1.5 0 0 0 3 4v8a1.5 1.5 0 0 0 1.5 1.5h2" />
        <rect x="6.5" y="4.5" width="7" height="7" rx="1.5" />
      </g>
    </svg>
    <span class="codechip-label" data-copy-label>Copy</span>
  </button>
</div>