---
import { installCommand } from "../data/trust";
import CodeChip from "./CodeChip.astro";
---

<section
  class="section bg-[color-mix(in_oklch,var(--color-bg)_92%,var(--color-surface))] border-y border-border"
  id="install"
>
  <div class="wrap">
    <div class="install-body flex flex-col gap-6 max-w-[34rem]" data-reveal>
      <h2>Install</h2>
      <CodeChip command={installCommand} />
      <p class="font-mono text-[0.8125rem] text-ink-soft leading-[1.55]">
        Claude Code, Cursor, Codex, Copilot - any agent that reads Markdown skills.
        Verify: <span class="text-ink">"which Roblox skills do you have?"</span>
      </p>
    </div>
  </div>
</section>
