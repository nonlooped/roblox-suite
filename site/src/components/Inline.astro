---
// Render inline `code` spans from a plain string containing backtick pairs.
// Plain text is emitted as escaped text nodes; only matched backtick pairs
// become <code>. No set:html — content comes from our own data modules.
const { text = "" } = Astro.props as { text?: string };

type Node = { code: boolean; t: string };
const nodes: Node[] = [];
let buf = "";
let inCode = false;
for (const ch of text) {
  if (ch === "`") {
    nodes.push({ code: inCode, t: buf });
    buf = "";
    inCode = !inCode;
  } else {
    buf += ch;
  }
}
nodes.push({ code: inCode, t: buf });
---

{
  nodes.map((n) => (n.code ? <code>{n.t}</code> : n.t))
}