---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import { repoUrl } from "../data/catalog";

const path = Astro.url.pathname;
const onSkills = path.startsWith("/skills/");
const onInstall = path.startsWith("/install/");
---

<header class="site-header">
  <div class="island">
    <a class="brand" href="/" aria-label="Roblox Suite">
      <Mark />
      <span class="wordmark" aria-hidden="true"><span class="wm-a">Roblox</span> <span class="wm-b">Suite</span></span>
    </a>
    <div class="island-right">
      <nav class="nav" aria-label="Main">
        <span class="nav-pill" aria-hidden="true"></span>
        <a href="/skills/" aria-current={onSkills ? "page" : undefined}>Skills</a>
        <a class="nav-github" href={repoUrl}>
          <Icon name="star" />
          GitHub
        </a>
      </nav>
      <a class="button button--install" href="/install/" aria-current={onInstall ? "page" : undefined}>Install</a>
    </div>
  </div>
</header>
