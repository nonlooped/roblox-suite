---
interface Props {
  width?: number;
}

const { width = 44 } = Astro.props;
---

<svg class="mark" viewBox="0 0 40 28" width={width} height={(width * 28) / 40} aria-hidden="true" focusable="false">
  <path class="wing wing-l" d="M3 4.5 16 10.5V17.5L3 23.5Z" fill="#00A2FF" stroke="#00A2FF" stroke-width="3" stroke-linejoin="round"></path>
  <path class="wing wing-r" d="M37 4.5 24 10.5V17.5L37 23.5Z" fill="#00A2FF" stroke="#00A2FF" stroke-width="3" stroke-linejoin="round"></path>
  <rect class="knot" x="14.5" y="8" width="11" height="12" rx="3" fill="#fff"></rect>
  <circle cx="20" cy="14" r="2.3" fill="#05060A"></circle>
</svg>
