---
import { featuredOldVsNew } from "../data/old-vs-new";
import { skillsBySlug } from "../data/skills-meta";
import SectionHeading from "./SectionHeading.astro";

const base = import.meta.env.BASE_URL;
---

<section class="section oldvsnew">
  <div class="wrap">
    <SectionHeading
      title="What you stop doing."
      lead="The suite replaces confidently-wrong defaults with the current, documented way. Each row maps to a skill — and to the official docs behind it."
    />

    <table class="ovn">
      <caption class="sr-only">
        Old way versus the suite's current way, per skill.
      </caption>
      <thead>
        <tr>
          <th scope="col" class="ovn__colhead">Old way</th>
          <th scope="col" class="ovn__colhead">The suite way</th>
        </tr>
      </thead>
      <tbody>
        {
          featuredOldVsNew.map((row) => {
            const skill = skillsBySlug.get(row.slug);
            return (
              <tr class="ovn__row">
                <td class="ovn__old" data-label="Old way">
                  <div class="ovn__cell">
                    <span class="ovn__mark ovn__mark--x" aria-hidden="true">
                      ✕
                    </span>
                    <p class="ovn__old-text">{row.old}</p>
                  </div>
                </td>
                <td class="ovn__new" data-label="The suite way">
                  <div class="ovn__cell">
                    <span class="ovn__mark ovn__mark--check" aria-hidden="true">
                      ✓
                    </span>
                    <div class="ovn__new-body">
                      <p class="ovn__new-text">{row.new}</p>
                      {row.note && <p class="ovn__note muted">{row.note}</p>}
                      <div class="ovn__meta">
                        {row.current && <span class="ovn__current">current</span>}
                        {skill && (
                          <a
                            class="ovn__skill link link--arrow"
                            href={`${base}skills/${row.slug}`}
                          >
                            {skill.title}
                            <span class="arrow" aria-hidden="true">→</span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .ovn {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    margin-top: var(--space-6);
  }
  .ovn__colhead {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    padding: 0 0 var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  .ovn tbody td {
    width: 50%;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .ovn tbody tr:last-child td {
    border-bottom: none;
  }
  .ovn__cell {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .ovn__mark {
    flex: none;
    width: 1.3em;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .ovn__mark--x { color: var(--muted); }
  .ovn__mark--check {
    color: var(--crimson);
    font-weight: 700;
  }
  .ovn__old-text { color: var(--muted); }
  .ovn__new-text { color: var(--ink); }
  .ovn__note {
    font-size: 0.875rem;
    margin-top: 0.35em;
    line-height: 1.5;
  }
  .ovn__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-3);
  }
  .ovn__current {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--crimson);
    background: var(--crimson-tint);
    border: 1px solid var(--crimson-line);
    padding: 0.15em 0.55em;
    border-radius: 999px;
  }
  .ovn__skill { font-size: 0.9375rem; }

  @media (max-width: 720px) {
    .ovn,
    .ovn tbody,
    .ovn tr {
      display: block;
    }
    .ovn thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .ovn__row {
      padding: var(--space-5) 0;
      border-bottom: 1px solid var(--border);
    }
    .ovn tbody tr:last-child {
      border-bottom: none;
    }
    .ovn tbody td {
      display: block;
      width: 100%;
      padding: 0;
      border: none;
    }
    .ovn tbody td::before {
      content: attr(data-label);
      display: block;
      font-size: 0.6875rem;
      font-weight: 700;
      color: var(--muted);
      margin-bottom: 0.5em;
    }
    .ovn__old {
      margin-bottom: var(--space-4);
    }
  }
</style>