---
// Section title + optional lead. Sentence-case, no eyebrow, no number.
const {
  title,
  lead,
  id,
  as: Tag = "h2",
  className = "",
} = Astro.props as {
  title: string;
  lead?: string;
  id?: string;
  as?: "h2" | "h3";
  className?: string;
};
---

<div class:list={["flex flex-col gap-4 max-w-[62ch]", className]} id={id}>
  <Tag>{title}</Tag>
  {lead && <p class="text-ink-soft text-[1.0625rem] leading-[1.55]">{lead}</p>}
</div>