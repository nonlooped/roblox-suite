---
import SectionHeading from "./SectionHeading.astro";

// Real stale patterns the suite replaces. Grounded in the repo's own
// call-outs — warm, not shaming.
const items = [
  {
    code: "Humanoid:LoadAnimation",
    note: "Deprecated since the Animator refactor — still the top result for “how to play an animation.”",
  },
  {
    code: "BodyPosition · BodyVelocity · BodyGyro",
    note: "Replaced by mover constraints years ago — tutorials still hand them out for anything that moves.",
  },
  {
    code: "ParticleEmitters in a ViewportFrame",
    note: "3D ParticleEmitters never render in ViewportFrame — a persistent myth that ships broken effects.",
  },
  {
    code: "Bare SetAsync on player save",
    note: "Race conditions under load silently corrupt or lose player data.",
  },
];
---

<section class="section problem" id="stop">
  <div class="wrap problem__grid">
    <SectionHeading
      title="Roblox moves fast. Most guides don't."
      lead="The engine deprecates APIs, renames services, and changes policy on a rolling basis. Most of what an agent finds online was right once — and is quietly wrong now."
    />
    <ul class="problem__list">
      {
        items.map((it) => (
          <li class="problem__item">
            <span class="problem__x" aria-hidden="true">
              ✕
            </span>
            <div class="problem__body">
              <p class="problem__code mono">{it.code}</p>
              <p class="muted problem__note">{it.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .problem__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .problem__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .problem__item {
    display: grid;
    grid-template-columns: 1.4em 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .problem__x {
    color: var(--muted);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.5;
    text-align: center;
  }
  .problem__body {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .problem__code {
    color: var(--ink-soft);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .problem__note {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (max-width: 820px) {
    .problem__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>