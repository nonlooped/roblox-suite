---
import { repoUrl, skillsShUrl } from "../data/trust";

const base = import.meta.env.BASE_URL;

const cols = [
  {
    label: "Explore",
    links: [
      { label: "All skills", href: `${base}skills` },
      { label: "What you stop doing", href: `${base}skills/roblox-animation` },
      { label: "Install", href: `${base}#install` },
      { label: "GitHub", href: repoUrl },
      { label: "skills.sh listing", href: skillsShUrl },
    ],
  },
  {
    label: "Sources",
    links: [
      { label: "Engine API Reference", href: "https://create.roblox.com/docs/reference/engine" },
      { label: "Docs for agents", href: "https://create.roblox.com/docs/llms.txt" },
      { label: "Engine API for agents", href: "https://create.roblox.com/docs/reference/engine/llms.txt" },
      { label: "Luau docs", href: "https://create.roblox.com/docs/luau" },
    ],
  },
];
---

<footer
  class="mt-auto border-t border-border bg-[color-mix(in_oklch,var(--color-bg)_96%,var(--color-surface))]"
>
  <div class="wrap flex flex-wrap gap-x-10 gap-y-8 py-[clamp(3rem,6vw,4.5rem)]">
    <div class="flex-1 basis-[22rem] flex flex-col gap-3">
      <a
        class="wordmark inline-flex items-center gap-2.5 font-bold text-[1.0625rem] tracking-[-0.02em] text-ink"
        href={base}
      >
        <svg class="text-crimson" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M5 22 L12 15 L17 19 L27 9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="27" cy="9" r="2.8" fill="currentColor" />
        </svg>
        <span>Roblox Suite</span>
      </a>
      <p class="text-ink-soft max-w-[36ch] text-[0.9375rem] leading-[1.55]">
        An opinionated, current skill set for Roblox Luau — accountable to the
        Engine API Reference.
      </p>
      <p class="font-mono text-[0.8125rem] text-muted">MIT</p>
    </div>

    <nav class="flex flex-wrap gap-x-10 gap-y-8 flex-[0_1_auto]" aria-label="Footer">
      {
        cols.map((col) => (
          <div class="min-w-[10rem]">
            <h3 class="text-xs font-semibold text-muted mb-3">{col.label}</h3>
            <ul class="flex flex-col gap-2">
              {col.links.map((l) => (
                <li>
                  <a
                    class="text-[0.9375rem] text-ink-soft transition-colors duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:text-ink"
                    href={l.href}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap border-t border-border py-6">
    <p class="text-[0.8125rem] text-muted max-w-[80ch]">
      © 2026 nonlooped · MIT License. Roblox Suite is an independent project,
      not affiliated with or endorsed by Roblox Corporation.
    </p>
  </div>
</footer>