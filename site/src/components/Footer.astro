---
import { repoUrl, skillCount } from "../data/catalog";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();

const columns = [
  {
    title: "Site",
    links: [
      { label: "Home", href: `${base}/` },
      { label: "Skills", href: `${base}/skills/` },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: repoUrl },
      { label: "Contributing", href: `${repoUrl}/blob/main/CONTRIBUTING.md` },
      { label: "Report a problem", href: `${repoUrl}/issues/new?template=inaccuracy.yml` },
    ],
  },
  {
    title: "Roblox",
    links: [
      { label: "Engine API", href: "https://create.roblox.com/docs/reference/engine" },
      { label: "Luau docs", href: "https://create.roblox.com/docs/luau" },
    ],
  },
];
---

<footer class="border-t border-ink bg-ink text-on-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-[1.4fr_2fr]">
    <div>
      <div class="flex items-center gap-2.5 font-display text-base font-bold">
        <span class="relative block size-6" aria-hidden="true">
          <span
            class="absolute left-0 top-0 h-3 w-4.5 rounded-[3px] border-2 border-paper/30 bg-paper"
          ></span>
          <span
            class="absolute bottom-0 right-0 h-3 w-4.5 rounded-[3px] border-2 border-paper/30 bg-toy-yellow"
          ></span>
        </span>
        Roblox Suite
      </div>
      <p class="mt-4 max-w-xs text-small text-on-ink-muted">
        {skillCount} Roblox skills for coding agents, each one linked back to the official docs.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <h2 class="font-display text-small font-bold text-toy-yellow">{column.title}</h2>
            {/* Pad footer links for touch input; negative margins keep the text aligned with the heading. */}
            <ul class="mt-3 flex flex-col gap-0.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="noopener"
                    class="-mx-2 inline-flex min-h-9 items-center px-2 text-small text-on-ink-muted transition-colors hover:text-on-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 border-t border-ink-soft px-6 py-6 text-small text-on-ink-muted"
  >
    <p>© {year} nonlooped, MIT licensed</p>
    <p>Not affiliated with or endorsed by Roblox Corporation.</p>
  </div>
</footer>
