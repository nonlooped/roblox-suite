---
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import { repoUrl, reportUrl } from "../data/catalog";

const path = Astro.url.pathname;
const onInstall = path.startsWith("/install/");
const onSkills = path.startsWith("/skills/") && path === "/skills/";

const columns = [
  {
    title: "Site",
    links: [
      { label: "Skills", href: "/skills/" },
      { label: "Install", href: "/install/" },
    ],
  },
  {
    title: "Project",
    links: [
      { label: "GitHub", href: repoUrl },
      { label: "Contributing", href: `${repoUrl}/blob/main/CONTRIBUTING.md` },
      { label: "Report an issue", href: reportUrl },
      { label: "Privacy", href: `${repoUrl}/blob/main/PRIVACY.md` },
      { label: "skills.sh", href: "https://www.skills.sh/nonlooped/roblox-suite/roblox" },
    ],
  },
  {
    title: "Roblox docs",
    links: [
      { label: "Creator Hub", href: "https://create.roblox.com/docs" },
      { label: "Engine API", href: "https://create.roblox.com/docs/reference/engine" },
      { label: "Luau", href: "https://create.roblox.com/docs/luau" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-lead">
        <Mark width={56} />
        <p class="footer-tag">Roblox skills for AI agents.</p>
        <div class="footer-actions">
          {!onInstall && <a class="button button--lg" href="/install/">Install skills</a>}
          {!onSkills && <a class="button button--lg button--ghost" href="/skills/">Browse skills</a>}
        </div>
      </div>
      <div class="footer-cols">
        {
          columns.map((column) => (
            <nav aria-label={column.title}>
              <p class="footer-title">{column.title}</p>
              <ul>
                {column.links.map((link) => {
                  const external = link.href.startsWith("http");
                  return (
                    <li>
                      <a class="footer-link" href={link.href}>
                        <span>{link.label}</span>
                        {external && <Icon name="arrow-up-right" />}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="giant" aria-hidden="true" data-glow>
      <div class="giant-clip">
        <span class="giant-text giant-base">Roblox Suite</span>
        <span class="giant-text giant-lit">Roblox Suite</span>
      </div>
    </div>

    <div class="footer-bar">
      <p>MIT license</p>
      <p>Not affiliated with Roblox Corporation</p>
    </div>
  </div>
</footer>
