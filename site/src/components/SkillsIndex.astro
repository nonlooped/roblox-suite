---
import { groups } from "../data/groups";
import { skillsForGroup } from "../data/skills-meta";
import Inline from "./Inline.astro";

const base = import.meta.env.BASE_URL;

// One consistent treatment for all six domains - a flat, borderless list
// under a hairline-ruled header. No per-index card/stripe rotation: the
// domains are peers, so they read as peers. The hub is the only row that
// earns distinction, and it earns it with the "Start here" pill, not a
// decorative side-stripe.
---

<div class="flex flex-col gap-[clamp(2.5rem,5vw,4rem)]">
  {
    groups.map((group) => {
      const list = skillsForGroup(group.skills);
      if (!list.length) return null;
      return (
        <section class="flex flex-col" aria-labelledby={`g-${group.id}`}>
          <header class="flex flex-wrap items-baseline gap-3 mb-3 pb-3 border-b border-border">
            <h3 class="text-[1.25rem]" id={`g-${group.id}`}>
              {group.title}
            </h3>
            <span class="ml-auto font-mono text-xs text-ink-soft">
              {list.length} {list.length === 1 ? "skill" : "skills"}
            </span>
          </header>

          <ul class="flex flex-col">
            {list.map((s) => (
              <li>
                <a
                  class="group flex flex-col gap-1.5 py-4 px-3 -mx-3 rounded-sm transition-[background,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-surface motion-safe:hover:translate-x-[3px]"
                  href={`${base}skills/${s.slug}`}
                >
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    {s.hub && (
                      <span
                        class="text-[0.625rem] font-bold text-on-crimson bg-crimson px-[0.55em] py-[0.18em] rounded-full tracking-[0.02em] uppercase"
                        aria-hidden="true"
                      >
                        Start here
                      </span>
                    )}
                    <span class="font-semibold text-ink text-[1.0625rem]">
                      {s.title}
                    </span>
                    <span class="ml-auto font-mono text-xs text-muted whitespace-nowrap transition-colors duration-200 group-hover:text-crimson max-[540px]:ml-0">
                      {s.slug}
                    </span>
                  </span>
                  <span class="text-ink-soft text-sm leading-[1.5]">
                    <Inline text={s.oneLiner} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
