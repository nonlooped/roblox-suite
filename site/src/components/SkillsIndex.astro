---
import { groups } from "../data/groups";
import { skillsForGroup } from "../data/skills-meta";
import Inline from "./Inline.astro";

const base = import.meta.env.BASE_URL;

// Alternate surface treatments so each domain section reads as composed,
// not as six identical dark-on-dark blocks.
const treatments = ["flat", "tinted", "lined"] as const;
const treatmentClass: Record<(typeof treatments)[number], string> = {
  flat: "bg-transparent border border-transparent",
  tinted: "bg-surface border border-border p-8",
  lined: "border-l-2 border-l-crimson-line pl-8",
};
---

<div class="flex flex-col gap-[clamp(2rem,4vw,3.5rem)]">
  {
    groups.map((group, i) => {
      const list = skillsForGroup(group.skills);
      if (!list.length) return null;
      const treatment = treatments[i % treatments.length];
      return (
        <section
          class:list={[
            "flex flex-col rounded-xl transition-[border-color,background] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)]",
            treatmentClass[treatment],
          ]}
          aria-labelledby={`g-${group.id}`}
        >
          <header class="flex flex-col gap-3 mb-5 pb-4 border-b border-border">
            <div class="flex flex-wrap items-baseline gap-3">
              <span
                class="font-mono text-xs font-semibold text-muted"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="text-[1.25rem]" id={`g-${group.id}`}>
                {group.title}
              </h3>
              <span class="ml-auto font-mono text-xs text-muted">
                {list.length} {list.length === 1 ? "skill" : "skills"}
              </span>
            </div>
            <p class="text-muted text-sm leading-[1.5] max-w-[56ch]">
              {group.description}
            </p>
          </header>

          <ul class="flex flex-col gap-1">
            {list.map((s) => (
              <li>
                <a
                  class:list={[
                    "group flex flex-col gap-2 p-4 rounded-sm border border-transparent transition-[background,border-color,transform] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-surface hover:border-border motion-safe:hover:translate-x-[3px]",
                    s.hub && "border-l-2 border-l-crimson-line pl-[calc(1rem-2px)]",
                  ]}
                  href={`${base}skills/${s.slug}`}
                >
                  <span class="flex flex-wrap items-center gap-3">
                    {s.hub && (
                      <span
                        class="text-[0.625rem] font-bold text-on-crimson bg-crimson px-[0.55em] py-[0.18em] rounded-full tracking-[0.02em] uppercase"
                        aria-hidden="true"
                      >
                        Start here
                      </span>
                    )}
                    <span class="font-semibold text-ink text-[1.0625rem]">
                      {s.title}
                    </span>
                    <span class="ml-auto font-mono text-xs text-muted whitespace-nowrap transition-colors duration-200 group-hover:text-crimson max-[540px]:ml-0">
                      {s.slug}
                    </span>
                  </span>
                  <span class="text-ink-soft text-sm leading-[1.5]">
                    <Inline text={s.oneLiner} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>