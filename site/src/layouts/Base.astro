---
import "../styles/global.css";
import "@fontsource/spline-sans-mono/latin-400.css";
import "@fontsource/spline-sans-mono/latin-500.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { repoUrl, skillsShUrl, freshness } from "../data/trust";
import { skillCount } from "../data/skills-meta";

interface Props {
  title?: string;
  description?: string;
  /** Override the default OG image path (relative to base). */
  ogImage?: string;
  /** Mark this page as an article (enables article: meta + TechArticle JSON-LD). */
  article?: boolean;
  /** Article section/genre for og:article:section. */
  section?: string;
  /** Article tags. */
  tags?: string[];
  /** Article published/modified ISO dates. */
  publishedAt?: string;
  /** Prevent indexing of this page. */
  noindex?: boolean;
}

const siteName = "Roblox Suite";
const { title, description, ogImage, article, section, tags, publishedAt, noindex } = Astro.props;

const base = import.meta.env.BASE_URL;
const siteOrigin = (Astro.site ?? "https://nonlooped.github.io").toString().replace(/\/$/, "");

const fullTitle = title
  ? `${title} · ${siteName}`
  : `Roblox Luau skills for AI agents · ${siteName}`;
const desc =
  description ??
  `${skillCount} Roblox Luau skills for AI agents. Every API recommendation is cited to the official Engine API Reference.`;

// Canonical - strip trailing index/default.html noise, normalize trailing slash.
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();

// OG image: page can override, otherwise the branded default.
const imgPath = ogImage ?? "og.png";
const ogImageUrl = new URL(`${base}${imgPath}`.replace(/\/+/g, "/"), siteOrigin).toString();

// Keywords: a focused set the whole site ranks around, augmented per-page.
const baseKeywords = [
  "Roblox",
  "Roblox Luau",
  "Roblox Studio",
  "Roblox API",
  "Roblox Engine API",
  "Roblox development",
  "AI coding agent",
  "skills.sh",
  "Roblox Suite",
];
const keywords = Array.from(new Set([...baseKeywords, ...(tags ?? [])])).join(", ");

const author = "nonlooped";
const twitterHandle = "@nonlooped";

// robots meta: noindex wins if requested; otherwise index+follow + max-image-preview.
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// JSON-LD: WebSite schema on every page. No SearchAction - the site has no
// working ?q= search, and a non-functional SearchAction target is a known
// trigger for Google's "spammy structured data" manual actions. Google
// deprecated the sitelinks search box entirely in 2025.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: `${siteOrigin}${base}`.replace(/\/+$/, "/"),
  description: desc,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: siteName,
    url: repoUrl,
    logo: `${siteOrigin}${base}favicon.svg`,
    sameAs: [repoUrl, skillsShUrl],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="grl63lB2HzFOQv_Xq2OfDJqAbwZCpIUmr7tijM15jLU" />

    {/* JS-gate: mark <html> as JS-enabled before first paint so CSS can
        scope the pre-animation hidden state to JS-capable clients only.
        No-JS users see content immediately (LCP/CLS-safe). Reduced-motion
        users also get visible content - the inline script sets the class
        but the Motion code short-circuits to is-visible. */}
    <script is:inline>
      (function () {
        var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!reduce) document.documentElement.classList.add("js");
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={author} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />

    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#1a1a1a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />
    <link rel="mask-icon" href={`${base}favicon.svg`} color="#e11d48" />

    {/* Performance hints to the Roblox docs (we link out a lot). */}
    <link rel="preconnect" href="https://create.roblox.com" crossorigin />
    <link rel="dns-prefetch" href="https://create.roblox.com" />

    {/* Open Graph */}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteName} · ${fullTitle}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {article && <meta property="article:author" content={author} />}
    {article && <meta property="article:publisher" content={repoUrl} />}
    {article && section && <meta property="article:section" content={section} />}
    {article && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {article && <meta property="article:modified_time" content={freshness.lastReviewed} />}
    {article && tags && tags.map((t) => <meta property="article:tag" content={t} />)}

    {/* Twitter - large image summary card for richer shares */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${siteName} · ${fullTitle}`} />

    {/* JSON-LD: WebSite on every page */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-6 focus:top-3 focus:z-[1000] focus:bg-surface focus:text-ink focus:px-4 focus:py-3 focus:rounded-sm focus:border focus:border-border-strong transition-top duration-200"
      href="#main"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal: native IntersectionObserver + Web Animations API.
      // No Motion library - drops the JS bundle from ~63KB to ~1KB inline.
      // The initial hidden state is owned by CSS (`.js [data-reveal]`),
      // gated on <html class="js"> which the inline head script sets only
      // when JS is available AND reduced-motion is not requested. This
      // keeps content visible for no-JS users (LCP/CLS-safe) and for
      // reduced-motion users. Here we only run the animation and add
      // .is-visible as a CSS-level restore fallback.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const ease = "cubic-bezier(0.22, 1, 0.36, 1)";
      const DURATION = 620;

      const reveal = (el: HTMLElement) => {
        if (reduce) {
          el.classList.add("is-visible");
          return;
        }
        el.animate(
          [
            { opacity: 0, transform: "translateY(18px)" },
            { opacity: 1, transform: "none" },
          ],
          { duration: DURATION, easing: ease, fill: "forwards" }
        ).onfinish = () => el.classList.add("is-visible");
      };

      const revealStagger = (el: HTMLElement) => {
        const children = Array.from(el.children) as HTMLElement[];
        if (!children.length) return;
        if (reduce) {
          children.forEach((c) => c.classList.add("is-visible"));
          el.classList.add("is-visible");
          return;
        }
        children.forEach((child, i) => {
          child.animate(
            [
              { opacity: 0, transform: "translateY(14px)" },
              { opacity: 1, transform: "none" },
            ],
            { duration: DURATION, delay: 60 * i, easing: ease, fill: "both" }
          );
        });
        el.classList.add("is-visible");
      };

      // Reduced-motion: CSS already shows content (no .js class on <html>),
      // so nothing to do here. Only wire up IntersectionObserver for
      // motion-capable clients.
      if (!reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                if (el.hasAttribute("data-reveal-stagger")) revealStagger(el);
                else reveal(el);
                io.unobserve(el);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
        );
        document
          .querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-stagger]")
          .forEach((el) => io.observe(el));
      }

      // Delegated copy handler for [data-copy] buttons. Uses the async
      // Clipboard API when available; falls back to execCommand on a temp
      // selection for insecure/old contexts; surfaces failure honestly
      // instead of flashing "Copied" when nothing was copied.
      document.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-copy]");
        if (!btn) return;
        const sel = btn.getAttribute("data-copy");
        const el = sel ? document.querySelector(sel) : null;
        const text = el ? (el.textContent || "").trim() : "";
        if (!text) return;
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        const orig = label && btn.dataset.copyLabel ? btn.dataset.copyLabel : label?.textContent;
        const succeed = () => {
          if (label) label.textContent = "Copied";
          btn.classList.add("is-copied");
          window.setTimeout(() => {
            btn.classList.remove("is-copied");
            if (label && orig) label.textContent = orig;
          }, 1600);
        };
        const fail = () => {
          if (label) label.textContent = "Copy failed - select & \u2318C";
          window.setTimeout(() => {
            if (label && orig) label.textContent = orig;
          }, 2600);
        };
        const w = navigator.clipboard?.writeText?.bind(navigator.clipboard);
        if (w) {
          w(text).then(succeed, fail);
        } else {
          // execCommand fallback for non-secure contexts (http) / old browsers.
          const ta = document.createElement("textarea");
          ta.value = text;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.top = "0";
          ta.style.left = "0";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          let ok = false;
          try { ok = document.execCommand("copy"); } catch { ok = false; }
          document.body.removeChild(ta);
          if (ok) succeed(); else fail();
        }
      });
    </script>
  </body>
</html>