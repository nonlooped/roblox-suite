---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/geist-mono";
import "../styles/base.css";
import "../styles/pages.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  landing?: boolean;
}

const { title, description, noindex = false, landing = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Google Search Console HTML-tag verification for roblox.nonlooped.xyz.
const googleSiteVerification = "d5maEtSw1GYOz8UJ1bQmUxojH-Pk34YWDovb2u_cR_Q";
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en" class:list={[{ "is-landing": landing }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content={googleSiteVerification} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Roblox Suite" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#05060A" />
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="bg-wash"></div>
      <slot name="aurora" />
      <div class="bg-dots"></div>
      <div class="bg-light"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!landing && <Footer />}
    <slot name="after" />
    <script>
      import "../scripts/ui.ts";
    </script>
  </body>
</html>
